<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.metallurgy.mapper.ProcessParamMapper">

    <resultMap type="ProcessParam" id="ProcessParamResult">
        <result property="id"           column="id"            />
        <result property="planName"     column="plan_name"     />
        <result property="oxygenConc"   column="oxygen_conc"   />
        <result property="oxygenRatio"  column="oxygen_ratio"  />
        <result property="feSio2Ratio"  column="fe_sio2_ratio" />
        <result property="matteGrade"   column="matte_grade"   />
        <result property="capacity"     column="capacity"      />
        <result property="status"       column="status"        />
        <result property="remark"       column="remark"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectProcessParamVo">
        select id, plan_name, oxygen_conc, oxygen_ratio, fe_sio2_ratio, matte_grade, capacity, status,
               remark, create_by, create_time, update_by, update_time
        from t_process_param
    </sql>

    <select id="selectProcessParamList" parameterType="ProcessParam" resultMap="ProcessParamResult">
        <include refid="selectProcessParamVo"/>
        <where>
            <if test="planName != null and planName != ''">
                and plan_name like concat('%', #{planName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by status asc, id desc
    </select>

    <select id="countProcessParam" parameterType="ProcessParam" resultType="long">
        select count(1) from t_process_param
        <where>
            <if test="planName != null and planName != ''">
                and plan_name like concat('%', #{planName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
    </select>

    <select id="selectProcessParamById" parameterType="Long" resultMap="ProcessParamResult">
        <include refid="selectProcessParamVo"/>
        where id = #{id}
    </select>

    <select id="selectEnabledProcessParam" resultMap="ProcessParamResult">
        <include refid="selectProcessParamVo"/>
        where status = '1'
        order by id desc
    </select>

    <select id="countCalcRecordByPlanId" parameterType="Long" resultType="int">
        select count(1) from t_calc_record where plan_id = #{id}
    </select>

    <insert id="insertProcessParam" parameterType="ProcessParam" useGeneratedKeys="true" keyProperty="id">
        insert into t_process_param
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planName != null and planName != ''">plan_name,</if>
            <if test="oxygenConc != null">oxygen_conc,</if>
            <if test="oxygenRatio != null">oxygen_ratio,</if>
            <if test="feSio2Ratio != null">fe_sio2_ratio,</if>
            <if test="matteGrade != null">matte_grade,</if>
            <if test="capacity != null">capacity,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planName != null and planName != ''">#{planName},</if>
            <if test="oxygenConc != null">#{oxygenConc},</if>
            <if test="oxygenRatio != null">#{oxygenRatio},</if>
            <if test="feSio2Ratio != null">#{feSio2Ratio},</if>
            <if test="matteGrade != null">#{matteGrade},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateProcessParam" parameterType="ProcessParam">
        update t_process_param
        <trim prefix="SET" suffixOverrides=",">
            <if test="planName != null and planName != ''">plan_name = #{planName},</if>
            <if test="oxygenConc != null">oxygen_conc = #{oxygenConc},</if>
            <if test="oxygenRatio != null">oxygen_ratio = #{oxygenRatio},</if>
            <if test="feSio2Ratio != null">fe_sio2_ratio = #{feSio2Ratio},</if>
            <if test="matteGrade != null">matte_grade = #{matteGrade},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProcessParamById" parameterType="Long">
        delete from t_process_param where id = #{id}
    </delete>

    <delete id="deleteProcessParamByIds" parameterType="String">
        delete from t_process_param where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
